<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Smart Alerts</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">

  <%- include("../partials/navbar") %>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <section class="mb-8">
      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-3xl p-8 text-white shadow-lg">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div>
            <h1 class="text-3xl sm:text-4xl font-bold mb-2">Smart Alerts</h1>
            <p class="text-blue-100 text-lg max-w-2xl">
              Monitor your daily usage, trigger warning alerts, and stay in control before screen time becomes excessive.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <button id="enableNotificationsBtn"
              class="px-5 py-3 rounded-2xl bg-white text-blue-700 font-semibold hover:bg-blue-50 transition shadow">
              Enable Notifications
            </button>

            <button id="testAlertBtn"
              class="px-5 py-3 rounded-2xl bg-red-500 text-white font-semibold hover:bg-red-600 transition shadow">
              Send Test Alert
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-2xl shadow border border-slate-200 p-6">
        <p class="text-sm text-slate-500 mb-2">Today's Usage</p>
        <h2 id="todayUsageText" class="text-3xl font-bold text-blue-700">0 hrs</h2>
      </div>

      <div class="bg-white rounded-2xl shadow border border-slate-200 p-6">
        <p class="text-sm text-slate-500 mb-2">Warning Threshold</p>
        <h2 id="warningText" class="text-3xl font-bold text-yellow-600"><%= typeof warningThreshold !== 'undefined' ? warningThreshold : 2 %> hrs</h2>
      </div>

      <div class="bg-white rounded-2xl shadow border border-slate-200 p-6">
        <p class="text-sm text-slate-500 mb-2">Danger Threshold</p>
        <h2 id="dangerText" class="text-3xl font-bold text-red-600"><%= typeof alertThreshold !== 'undefined' ? alertThreshold : 4 %> hrs</h2>
      </div>

      <div class="bg-white rounded-2xl shadow border border-slate-200 p-6">
        <p class="text-sm text-slate-500 mb-2">Status</p>
        <h2 id="statusBadge"
          class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-green-100 text-green-700">
          Healthy
        </h2>
      </div>
    </section>

    <section class="grid grid-cols-1 xl:grid-cols-3 gap-8 mb-8">
      <div class="xl:col-span-2 bg-white rounded-3xl shadow border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-bold">Usage Progress</h2>
          <span id="progressPercentText" class="text-sm font-semibold text-slate-500">0%</span>
        </div>

        <div class="w-full h-5 rounded-full bg-slate-200 overflow-hidden mb-4">
          <div id="progressBar" class="h-5 rounded-full bg-green-500 transition-all duration-500" style="width: 0%"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
          <div class="rounded-2xl bg-slate-50 border p-4">
            <p class="text-sm text-slate-500">Time Left</p>
            <p id="timeLeftText" class="text-2xl font-bold text-green-700">0 hrs</p>
          </div>
          <div class="rounded-2xl bg-slate-50 border p-4">
            <p class="text-sm text-slate-500">Next Alert</p>
            <p id="nextAlertText" class="text-2xl font-bold text-yellow-700">Warning</p>
          </div>
          <div class="rounded-2xl bg-slate-50 border p-4">
            <p class="text-sm text-slate-500">Notification Access</p>
            <p id="notificationStateText" class="text-2xl font-bold text-blue-700">Unknown</p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-3xl shadow border border-slate-200 p-6">
        <h2 class="text-2xl font-bold mb-5">Set Alert Limits</h2>

        <form id="thresholdForm" class="space-y-5">
          <div>
            <label class="block text-sm font-semibold text-slate-600 mb-2">Warning Threshold (hours)</label>
            <input id="warningInput" name="warningThreshold" type="number" min="1" step="0.5"
              value="<%= typeof warningThreshold !== 'undefined' ? warningThreshold : 2 %>"
              class="w-full border border-slate-300 rounded-2xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500">
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-600 mb-2">Danger Threshold (hours)</label>
            <input id="dangerInput" name="alertThreshold" type="number" min="1" step="0.5"
              value="<%= typeof alertThreshold !== 'undefined' ? alertThreshold : 4 %>"
              class="w-full border border-slate-300 rounded-2xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500">
          </div>

          <button type="submit"
            class="w-full bg-blue-600 text-white py-3 rounded-2xl font-semibold hover:bg-blue-700 transition">
            Save Thresholds
          </button>
        </form>

        <div class="mt-6 pt-6 border-t">
          <h3 class="font-bold text-lg mb-3">Quick Actions</h3>
          <div class="grid grid-cols-1 gap-3">
            <button id="simulateUsageBtn"
              class="w-full py-3 rounded-2xl bg-yellow-500 text-white font-semibold hover:bg-yellow-600 transition">
              Simulate +30 min Usage
            </button>
            <button id="resetUsageBtn"
              class="w-full py-3 rounded-2xl bg-slate-700 text-white font-semibold hover:bg-slate-800 transition">
              Reset Demo Usage
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 xl:grid-cols-3 gap-8">
      <div class="xl:col-span-2 bg-white rounded-3xl shadow border border-slate-200 p-6">
        <h2 class="text-2xl font-bold mb-5">Recent Alerts</h2>
        <div id="alertHistory" class="space-y-4">
          <div class="text-slate-500">No alerts triggered yet.</div>
        </div>
      </div>

      <div class="bg-white rounded-3xl shadow border border-slate-200 p-6">
        <h2 class="text-2xl font-bold mb-5">How it Works</h2>
        <div class="space-y-4 text-slate-600">
          <div class="rounded-2xl border p-4 bg-slate-50">
            <p class="font-semibold text-slate-800 mb-1">Healthy</p>
            <p>Usage is safely below your warning threshold.</p>
          </div>
          <div class="rounded-2xl border p-4 bg-yellow-50">
            <p class="font-semibold text-yellow-700 mb-1">Warning</p>
            <p>You are approaching your daily limit. A notification can be triggered here.</p>
          </div>
          <div class="rounded-2xl border p-4 bg-red-50">
            <p class="font-semibold text-red-700 mb-1">Danger</p>
            <p>You crossed your danger threshold. Strong alerts are shown here.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include("../partials/footer") %>

  <div id="toast"
    class="fixed bottom-5 right-5 hidden px-5 py-4 rounded-2xl shadow-2xl text-white font-semibold z-50">
  </div>

  <script>
    const backendWarningThreshold = <%- JSON.stringify(typeof warningThreshold !== "undefined" ? warningThreshold : 2) %>;
    const backendDangerThreshold = <%- JSON.stringify(typeof alertThreshold !== "undefined" ? alertThreshold : 4) %>;
    const backendTodayUsage = <%- JSON.stringify(typeof todayUsage !== "undefined" ? todayUsage : 0) %>;

    const warningInput = document.getElementById("warningInput");
    const dangerInput = document.getElementById("dangerInput");
    const thresholdForm = document.getElementById("thresholdForm");

    const todayUsageText = document.getElementById("todayUsageText");
    const warningText = document.getElementById("warningText");
    const dangerText = document.getElementById("dangerText");
    const statusBadge = document.getElementById("statusBadge");
    const progressBar = document.getElementById("progressBar");
    const progressPercentText = document.getElementById("progressPercentText");
    const timeLeftText = document.getElementById("timeLeftText");
    const nextAlertText = document.getElementById("nextAlertText");
    const notificationStateText = document.getElementById("notificationStateText");
    const alertHistory = document.getElementById("alertHistory");
    const enableNotificationsBtn = document.getElementById("enableNotificationsBtn");
    const testAlertBtn = document.getElementById("testAlertBtn");
    const simulateUsageBtn = document.getElementById("simulateUsageBtn");
    const resetUsageBtn = document.getElementById("resetUsageBtn");
    const toast = document.getElementById("toast");

    let todayUsage = Number(localStorage.getItem("demo_today_usage"));
    if (isNaN(todayUsage)) {
      todayUsage = Number(backendTodayUsage) || 0;
    }

    let warningThreshold = Number(localStorage.getItem("demo_warning_threshold"));
    if (isNaN(warningThreshold)) {
      warningThreshold = Number(backendWarningThreshold) || 2;
    }

    let dangerThreshold = Number(localStorage.getItem("demo_danger_threshold"));
    if (isNaN(dangerThreshold)) {
      dangerThreshold = Number(backendDangerThreshold) || 4;
    }

    let alertLog = JSON.parse(localStorage.getItem("demo_alert_log") || "[]");
    let lastTriggeredState = localStorage.getItem("demo_last_triggered_state") || "";

    function saveLocalState() {
      localStorage.setItem("demo_today_usage", todayUsage);
      localStorage.setItem("demo_warning_threshold", warningThreshold);
      localStorage.setItem("demo_danger_threshold", dangerThreshold);
      localStorage.setItem("demo_alert_log", JSON.stringify(alertLog));
      localStorage.setItem("demo_last_triggered_state", lastTriggeredState);
    }

    function showToast(message, type = "info") {
      toast.className = "fixed bottom-5 right-5 px-5 py-4 rounded-2xl shadow-2xl text-white font-semibold z-50";
      if (type === "success") toast.classList.add("bg-green-600");
      else if (type === "warning") toast.classList.add("bg-yellow-500");
      else if (type === "danger") toast.classList.add("bg-red-600");
      else toast.classList.add("bg-slate-800");

      toast.textContent = message;
      toast.classList.remove("hidden");

      setTimeout(() => {
        toast.classList.add("hidden");
      }, 3000);
    }

    function getNotificationStatus() {
      if (!("Notification" in window)) return "Unsupported";
      return Notification.permission;
    }

    function updateNotificationText() {
      const status = getNotificationStatus();
      notificationStateText.textContent = status;
      notificationStateText.className = "text-2xl font-bold";

      if (status === "granted") notificationStateText.classList.add("text-green-700");
      else if (status === "denied") notificationStateText.classList.add("text-red-700");
      else notificationStateText.classList.add("text-blue-700");
    }

    async function requestNotificationPermission() {
      if (!("Notification" in window)) {
        showToast("This browser does not support notifications.", "danger");
        return;
      }

      const permission = await Notification.requestPermission();
      updateNotificationText();

      if (permission === "granted") {
        showToast("Notifications enabled successfully.", "success");
      } else {
        showToast("Notification permission was not granted.", "warning");
      }
    }

    function triggerBrowserNotification(title, body) {
      if ("Notification" in window && Notification.permission === "granted") {
        new Notification(title, { body });
      }
    }

    function addAlertToHistory(type, title, message) {
      alertLog.unshift({
        type,
        title,
        message,
        time: new Date().toLocaleString()
      });

      if (alertLog.length > 10) {
        alertLog = alertLog.slice(0, 10);
      }

      saveLocalState();
      renderAlertHistory();
    }

    function renderAlertHistory() {
      if (!alertLog.length) {
        alertHistory.innerHTML = `<div class="text-slate-500">No alerts triggered yet.</div>`;
        return;
      }

      alertHistory.innerHTML = alertLog.map(alert => {
        let color = "border-slate-200 bg-slate-50 text-slate-700";
        if (alert.type === "warning") color = "border-yellow-200 bg-yellow-50 text-yellow-700";
        if (alert.type === "danger") color = "border-red-200 bg-red-50 text-red-700";
        if (alert.type === "success") color = "border-green-200 bg-green-50 text-green-700";

        return `
          <div class="border rounded-2xl p-4 ${color}">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-bold">${alert.title}</h3>
              <span class="text-xs font-semibold">${alert.time}</span>
            </div>
            <p class="mt-2 text-sm">${alert.message}</p>
          </div>
        `;
      }).join("");
    }

    function getStatus() {
      if (todayUsage >= dangerThreshold) {
        return "Danger";
      }
      if (todayUsage >= warningThreshold) {
        return "Warning";
      }
      return "Healthy";
    }

    function updateUI() {
      warningText.textContent = `${warningThreshold} hrs`;
      dangerText.textContent = `${dangerThreshold} hrs`;
      todayUsageText.textContent = `${todayUsage.toFixed(1)} hrs`;

      const percent = Math.min((todayUsage / dangerThreshold) * 100, 100);
      progressBar.style.width = `${percent}%`;
      progressPercentText.textContent = `${percent.toFixed(0)}%`;

      const timeLeft = Math.max(dangerThreshold - todayUsage, 0);
      timeLeftText.textContent = `${timeLeft.toFixed(1)} hrs`;

      const status = getStatus();
      statusBadge.textContent = status;
      statusBadge.className = "inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold";

      if (status === "Healthy") {
        statusBadge.classList.add("bg-green-100", "text-green-700");
        progressBar.className = "h-5 rounded-full bg-green-500 transition-all duration-500";
        nextAlertText.textContent = "Warning";
        nextAlertText.className = "text-2xl font-bold text-yellow-700";
      } else if (status === "Warning") {
        statusBadge.classList.add("bg-yellow-100", "text-yellow-700");
        progressBar.className = "h-5 rounded-full bg-yellow-500 transition-all duration-500";
        nextAlertText.textContent = "Danger";
        nextAlertText.className = "text-2xl font-bold text-red-700";
      } else {
        statusBadge.classList.add("bg-red-100", "text-red-700");
        progressBar.className = "h-5 rounded-full bg-red-500 transition-all duration-500";
        nextAlertText.textContent = "Limit Crossed";
        nextAlertText.className = "text-2xl font-bold text-red-700";
      }

      updateNotificationText();
      checkAndTriggerAutoAlerts(status);
      saveLocalState();
    }

    function checkAndTriggerAutoAlerts(status) {
      if (status === "Warning" && lastTriggeredState !== "Warning") {
        const message = `You have reached ${todayUsage.toFixed(1)} hrs. Slow down before you hit the danger limit.`;
        addAlertToHistory("warning", "Warning Alert", message);
        showToast(message, "warning");
        triggerBrowserNotification("Screen Time Warning", message);
        lastTriggeredState = "Warning";
      }

      if (status === "Danger" && lastTriggeredState !== "Danger") {
        const message = `You crossed your danger threshold at ${todayUsage.toFixed(1)} hrs. Please take a break.`;
        addAlertToHistory("danger", "Danger Alert", message);
        showToast(message, "danger");
        triggerBrowserNotification("Danger: Screen Time Limit Crossed", message);
        lastTriggeredState = "Danger";
      }

      if (status === "Healthy" && lastTriggeredState !== "Healthy") {
        lastTriggeredState = "Healthy";
      }

      saveLocalState();
    }

    thresholdForm.addEventListener("submit", async function (e) {
      e.preventDefault();

      const newWarning = Number(warningInput.value);
      const newDanger = Number(dangerInput.value);

      if (newWarning <= 0 || newDanger <= 0) {
        showToast("Threshold values must be greater than 0.", "danger");
        return;
      }

      if (newWarning >= newDanger) {
        showToast("Danger threshold must be greater than warning threshold.", "danger");
        return;
      }

      warningThreshold = newWarning;
      dangerThreshold = newDanger;
      lastTriggeredState = "";
      saveLocalState();
      updateUI();

      try {
  const response = await fetch("/smart-alerts", {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      warningThreshold: newWarning,
      alertThreshold: newDanger
    })
  });

  const result = await response.json();

  if (!response.ok) {
    throw new Error(result.message || "Failed to save thresholds");
  }

  showToast(result.message || "Thresholds updated successfully.", "success");
} catch (error) {
  console.error("Backend save failed:", error);
  showToast(error.message || "Failed to save thresholds.", "danger");
}

    enableNotificationsBtn.addEventListener("click", requestNotificationPermission);

    testAlertBtn.addEventListener("click", function () {
      const message = "This is a test alert from Smart Alerts.";
      addAlertToHistory("success", "Test Notification", message);
      showToast(message, "success");
      triggerBrowserNotification("Smart Alerts Test", message);
    });

    simulateUsageBtn.addEventListener("click", function () {
      todayUsage += 0.5;
      updateUI();
      showToast("Added 30 minutes to demo usage.", "warning");
    });

    resetUsageBtn.addEventListener("click", function () {
      todayUsage = 0;
      lastTriggeredState = "";
      alertLog = [];
      saveLocalState();
      renderAlertHistory();
      updateUI();
      showToast("Demo usage reset.", "success");
    });

    renderAlertHistory();
    updateUI();

    setInterval(() => {
      updateUI();
    }, 5000);
  </script>
</body>
</html>