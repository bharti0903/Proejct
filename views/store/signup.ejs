<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Signup</title>
  <link rel="stylesheet" href="/Output.css" />
</head>

<body class="min-h-screen bg-slate-950 text-slate-100">
  <%- include("../partials/navbar") %>

  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid lg:grid-cols-2 gap-10 items-center">
      <div class="hidden lg:block">
        <div class="relative overflow-hidden rounded-[32px] border border-white/10 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 p-10 shadow-2xl">
          <div class="absolute -top-16 -left-16 h-56 w-56 rounded-full bg-fuchsia-500/20 blur-3xl"></div>
          <div class="absolute -bottom-16 -right-16 h-56 w-56 rounded-full bg-cyan-500/20 blur-3xl"></div>

          <div class="relative">
            <p class="text-sm uppercase tracking-[0.3em] text-fuchsia-300/80 mb-3">
              Join DAAT
            </p>

            <h1 class="text-4xl font-extrabold text-white leading-tight mb-4">
              Build Better <br/> Digital Habits
            </h1>

            <p class="text-slate-300 leading-relaxed">
              Create your account and start monitoring screen time, blocking distractions, and improving your productivity with a premium digital wellness experience.
            </p>

            <div class="mt-8 space-y-3 text-sm text-slate-400">
              <p>✔ Personalized usage limits</p>
              <p>✔ Smart warning & danger alerts</p>
              <p>✔ Weekly reports and insights</p>
            </div>
          </div>
        </div>
      </div>

      <div class="w-full max-w-md mx-auto">
        <div class="relative overflow-hidden rounded-[28px] border border-white/10 bg-slate-900/80 backdrop-blur-xl p-8 shadow-2xl">
          <div class="absolute -top-10 -left-10 h-32 w-32 rounded-full bg-fuchsia-500/20 blur-2xl"></div>

          <div class="relative">
            <h1 class="text-3xl font-extrabold text-white mb-2">Create account</h1>
            <p class="text-slate-400 mb-6">Start tracking healthier digital habits.</p>

            <% if (error) { %>
              <div class="mb-4 rounded-2xl border border-rose-400/20 bg-rose-500/10 p-4 text-rose-200">
                <%= error %>
              </div>
            <% } %>

            <form action="/signup" method="POST" class="grid gap-5">
              <div>
                <label class="block mb-2 text-sm font-semibold text-slate-300">Name</label>
                <input
                  type="text"
                  name="name"
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none placeholder:text-slate-500 focus:border-fuchsia-400/40"
                  placeholder="Enter your name"
                  required
                />
              </div>

              <div>
                <label class="block mb-2 text-sm font-semibold text-slate-300">Email</label>
                <input
                  type="email"
                  name="email"
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none placeholder:text-slate-500 focus:border-fuchsia-400/40"
                  placeholder="Enter your email"
                  required
                />
              </div>

              <div>
                <label class="block mb-2 text-sm font-semibold text-slate-300">Password</label>
                <input
                  type="password"
                  name="password"
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none placeholder:text-slate-500 focus:border-fuchsia-400/40"
                  placeholder="Create a password"
                  required
                />
              </div>

              <div>
                <label class="block mb-2 text-sm font-semibold text-slate-300">Confirm Password</label>
                <input
                  type="password"
                  name="confirmPassword"
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-slate-100 outline-none placeholder:text-slate-500 focus:border-fuchsia-400/40"
                  placeholder="Confirm your password"
                  required
                />
              </div>

              <button
                type="submit"
                class="rounded-2xl bg-gradient-to-r from-fuchsia-500 to-indigo-600 px-6 py-3 text-white font-semibold shadow-lg shadow-fuchsia-900/30 hover:scale-[1.02] transition"
              >
                Sign Up
              </button>
            </form>

            <p class="text-sm text-slate-400 mt-6 text-center">
              Already have an account?
              <a href="/login" class="text-fuchsia-400 font-semibold hover:underline">
                Login
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include("../partials/footer") %>
</body>
</html>