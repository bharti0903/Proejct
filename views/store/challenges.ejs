<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Challenges</title>
  <link rel="stylesheet" href="/Output.css" />
</head>

<body class="min-h-screen bg-slate-950 text-slate-100">
  <%- include("../partials/navbar") %>

  <%
    function getStatusStyle(status) {
      const s = String(status || "").toLowerCase();

      if (s === "completed") {
        return "bg-emerald-500/15 text-emerald-300 border border-emerald-400/20";
      }

      if (s === "in progress") {
        return "bg-amber-500/15 text-amber-300 border border-amber-400/20";
      }

      return "bg-slate-500/15 text-slate-300 border border-slate-400/20";
    }
  %>

  <div class="max-w-6xl mx-auto px-4 py-8">

    <!-- Hero -->
    <div class="relative overflow-hidden rounded-[28px] border border-white/10 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 shadow-2xl mb-8">
      <div class="absolute -top-16 -left-16 h-56 w-56 rounded-full bg-indigo-500/20 blur-3xl"></div>
      <div class="absolute -bottom-16 -right-16 h-56 w-56 rounded-full bg-emerald-500/20 blur-3xl"></div>

      <div class="relative p-6 md:p-8">
        <p class="text-sm uppercase tracking-[0.25em] text-indigo-300/80 mb-2">Self Improvement</p>
        <h1 class="text-3xl md:text-4xl font-extrabold text-white">Challenges</h1>
        <p class="text-slate-300 mt-3 max-w-2xl">
          Push yourself with structured digital wellness challenges and build better habits over time.
        </p>
      </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid md:grid-cols-3 gap-4 mb-8">
      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-xl backdrop-blur">
        <p class="text-sm text-slate-400">Total Challenges</p>
        <p class="text-3xl font-bold text-white mt-2"><%= challenges.length %></p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-xl backdrop-blur">
        <p class="text-sm text-slate-400">In Progress</p>
        <p class="text-3xl font-bold text-amber-300 mt-2">
          <%= challenges.filter(c => String(c.status).toLowerCase() === "in progress").length %>
        </p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-xl backdrop-blur">
        <p class="text-sm text-slate-400">Completed</p>
        <p class="text-3xl font-bold text-emerald-300 mt-2">
          <%= challenges.filter(c => String(c.status).toLowerCase() === "completed").length %>
        </p>
      </div>
    </div>

    <!-- Challenges List -->
    <div class="space-y-5">

      <% if (!challenges || challenges.length === 0) { %>
        <div class="rounded-3xl border border-dashed border-white/10 bg-slate-900/70 p-10 text-center text-slate-400 shadow-xl backdrop-blur">
          No challenges available yet. Start building your digital discipline 🚀
        </div>
      <% } %>

      <% challenges.forEach(challenge => { %>
        <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-xl backdrop-blur">

          <div class="absolute -top-10 -left-10 h-28 w-28 rounded-full bg-indigo-500/10 blur-2xl"></div>

          <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-4">

            <!-- Left Content -->
            <div>
              <h2 class="text-xl font-bold text-white mb-1">
                <%= challenge.title %>
              </h2>

              <p class="text-slate-300 text-sm leading-relaxed">
                <%= challenge.description %>
              </p>

              <div class="mt-3">
                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide <%= getStatusStyle(challenge.status) %>">
                  <%= challenge.status %>
                </span>
              </div>
            </div>

            <!-- Right Action -->
            <div class="flex items-center gap-3">
              <% if (String(challenge.status).toLowerCase() !== "completed") { %>
                <button class="rounded-xl bg-gradient-to-r from-indigo-500 to-purple-600 px-4 py-2 text-white font-semibold shadow-lg">
                  Continue
                </button>
              <% } else { %>
                <span class="text-emerald-300 font-semibold">✔ Completed</span>
              <% } %>
            </div>

          </div>
        </div>
      <% }) %>
    </div>

  </div>

  <%- include("../partials/footer") %>
  <%- include("../partials/toast", { userId }) %>
</body>
</html>