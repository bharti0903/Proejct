<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Weekly Report</title>
  <link rel="stylesheet" href="/Output.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-slate-950 min-h-screen text-slate-100">
  <%- include("../partials/navbar") %>

  <%
    function formatDuration(hours) {
      const totalMinutes = Math.round((Number(hours) || 0) * 60);
      const hrs = Math.floor(totalMinutes / 60);
      const mins = totalMinutes % 60;

      if (hrs === 0) return `${mins} min`;
      if (mins === 0) return `${hrs} hr`;
      return `${hrs} hr ${mins} min`;
    }
  %>

  <div class="max-w-7xl mx-auto px-4 py-8">

    <!-- HERO -->
    <div class="relative overflow-hidden rounded-[28px] border border-white/10 bg-gradient-to-br from-slate-900 to-slate-950 p-8 mb-8 shadow-2xl">
      <div class="absolute -top-16 -left-16 h-56 w-56 bg-indigo-500/20 blur-3xl rounded-full"></div>
      <div class="absolute -bottom-16 -right-16 h-56 w-56 bg-cyan-500/20 blur-3xl rounded-full"></div>

      <div class="relative flex justify-between items-center flex-wrap gap-4">
        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-white">Weekly Report</h1>
          <p class="text-slate-400 mt-2">Your digital usage insights (last 7 days)</p>
        </div>

        <a href="/weekly-report/export-csv"
           class="px-5 py-3 rounded-xl bg-gradient-to-r from-indigo-500 to-cyan-600 text-white font-semibold shadow-lg">
          Download CSV
        </a>
      </div>
    </div>

    <!-- STATS -->
    <div class="grid md:grid-cols-2 xl:grid-cols-5 gap-4 mb-8">
      <% [
        ["Weekly Total", formatDuration(weeklyTotal)],
        ["Daily Average", formatDuration(weeklyAverage)],
        ["Score", productivityScore + "/100"],
        ["Level", productivityLabel],
        ["Top Category", topCategory]
      ].forEach(item => { %>

        <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-5 shadow-xl backdrop-blur">
          <p class="text-sm text-slate-400"><%= item[0] %></p>
          <p class="text-2xl font-bold text-white mt-2"><%= item[1] %></p>
        </div>

      <% }) %>
    </div>

    <!-- CHARTS -->
    <div class="grid xl:grid-cols-2 gap-8 mb-8">

      <!-- LINE -->
      <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-6 shadow-xl">
        <h2 class="text-xl font-bold mb-4">Usage Trend</h2>
        <canvas id="lineChart"></canvas>
      </div>

      <!-- PIE -->
      <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-6 shadow-xl">
        <h2 class="text-xl font-bold mb-4">Top Websites (Distribution)</h2>
        <canvas id="pieChart"></canvas>
      </div>
    </div>

    <!-- BAR -->
    <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-6 shadow-xl mb-8">
      <h2 class="text-xl font-bold mb-4">Daily Breakdown (Bar)</h2>
      <canvas id="barChart"></canvas>
    </div>

    <!-- TABLE -->
    <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-6 shadow-xl">
      <h2 class="text-xl font-bold mb-4">Daily Breakdown</h2>

      <table class="w-full text-sm">
        <thead class="text-slate-400 border-b border-white/10">
          <tr>
            <th class="p-3 text-left">Day</th>
            <th class="p-3 text-left">Time</th>
            <th class="p-3 text-left">Sessions</th>
          </tr>
        </thead>

        <tbody>
          <% weeklyRows.forEach(row => { %>
            <tr class="border-b border-white/5">
              <td class="p-3"><%= row.label %></td>
              <td class="p-3"><%= formatDuration(row.total) %></td>
              <td class="p-3"><%= row.sessions %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>

  <%- include("../partials/footer") %>
  <%- include("../partials/toast", { userId }) %>

  <script>
    const labels = <%- weeklyChartLabels %>;
    const data = <%- weeklyChartData %>;

    const topSites = <%- JSON.stringify(topWebsites || []) %>;

    // LINE CHART
    new Chart(document.getElementById("lineChart"), {
      type: "line",
      data: {
        labels,
        datasets: [{
          label: "Hours",
          data,
          tension: 0.4
        }]
      }
    });

    // BAR CHART
    new Chart(document.getElementById("barChart"), {
      type: "bar",
      data: {
        labels,
        datasets: [{
          label: "Hours",
          data
        }]
      }
    });

    // PIE CHART
    new Chart(document.getElementById("pieChart"), {
      type: "pie",
      data: {
        labels: topSites.map(s => s.domain),
        datasets: [{
          data: topSites.map(s => s.totalHours)
        }]
      }
    });
  </script>
</body>
</html>