<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/Output.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-slate-50 min-h-screen text-slate-800">
  <%- include("../partials/navbar") %>

  <% 
    function formatDuration(hours) {
      const totalMinutes = Math.round((Number(hours) || 0) * 60);
      const hrs = Math.floor(totalMinutes / 60);
      const mins = totalMinutes % 60;

      if (hrs === 0) return `${mins} min`;
      if (mins === 0) return `${hrs} hr`;
      return `${hrs} hr ${mins} min`;
    }
  %>

  <div class="max-w-7xl mx-auto px-4 py-8">

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900">Dashboard</h1>
      <p class="text-slate-600">
        Welcome, <%= userName || "User" %>.
      </p>
    </div>

    <% if (error) { %>
      <div class="mb-4 p-4 bg-red-100 text-red-700 rounded-lg">
        <%= error %>
      </div>
    <% } %>

    <!-- CARDS -->
    <div class="grid md:grid-cols-2 xl:grid-cols-5 gap-4 mb-8">

      <div class="bg-white p-5 rounded-2xl shadow">
        <p class="text-sm text-slate-500">Today</p>
        <p class="text-2xl font-bold text-indigo-700">
          <%= formatDuration(todayTotal) %>
        </p>
      </div>

      <div class="bg-white p-5 rounded-2xl shadow">
        <p class="text-sm text-slate-500">Time Left</p>
        <p class="text-2xl font-bold text-green-700">
          <%= formatDuration(timeLeft) %>
        </p>
      </div>

      <div class="bg-white p-5 rounded-2xl shadow">
        <p class="text-sm text-slate-500">Sessions</p>
        <p class="text-2xl font-bold text-blue-700">
          <%= todaySessionCount %>
        </p>
      </div>

      <div class="bg-white p-5 rounded-2xl shadow">
        <p class="text-sm text-slate-500">Top Category</p>
        <p class="text-xl font-bold"><%= mostUsedCategory %></p>
        <p class="text-sm text-slate-500">
          <%= formatDuration(mostUsedCategoryHours) %>
        </p>
      </div>

      <div class="bg-white p-5 rounded-2xl shadow">
        <p class="text-sm text-slate-500">Status</p>
        <p class="text-xl font-bold text-red-600"><%= usageStatus %></p>
      </div>

    </div>

    <!-- LIMITS -->
    <div class="bg-white p-6 rounded-2xl shadow mb-8">

      <div class="flex justify-between mb-2">
        <h2 class="text-xl font-bold">Daily Limit</h2>
        <span><%= progressPercent %>% used</span>
      </div>

      <div class="w-full h-3 bg-gray-200 rounded-full">
        <div class="bg-indigo-600 h-3 rounded-full"
             style="width:<%= progressPercent %>%"></div>
      </div>

      <div class="grid grid-cols-3 gap-4 mt-4">

        <div class="p-4 bg-yellow-50 rounded-xl">
          <p class="text-yellow-700 font-semibold">Warning</p>
          <p><%= formatDuration(warningLimit) %></p>
        </div>

        <div class="p-4 bg-red-50 rounded-xl">
          <p class="text-red-700 font-semibold">Danger</p>
          <p><%= formatDuration(dangerLimit) %></p>
        </div>

        <div class="p-4 bg-blue-50 rounded-xl">
          <p class="text-blue-700 font-semibold">Daily</p>
          <p><%= formatDuration(dailyLimit) %></p>
        </div>

      </div>
    </div>

    <!-- WEEKLY -->
    <div class="grid xl:grid-cols-2 gap-8 mb-8">

      <div class="bg-white p-6 rounded-2xl shadow">
        <h2 class="text-xl font-bold mb-4">Weekly Summary</h2>

        <div class="grid grid-cols-2 gap-4 mb-4">
          <div class="p-4 bg-gray-50 rounded-xl">
            <p>Total</p>
            <p class="font-bold"><%= formatDuration(weeklyTotal) %></p>
          </div>

          <div class="p-4 bg-gray-50 rounded-xl">
            <p>Average</p>
            <p class="font-bold"><%= formatDuration(weeklyAverage) %></p>
          </div>
        </div>

        <% weeklyBreakdown.forEach(day => { %>
          <div class="flex justify-between border p-3 rounded-lg mb-2">
            <span><%= day.label %></span>
            <span><%= formatDuration(day.total) %></span>
          </div>
        <% }) %>

      </div>

      <!-- TOP WEBSITES -->
      <div class="bg-white p-6 rounded-2xl shadow">
        <h2 class="text-xl font-bold mb-4">Top Websites</h2>

        <% topWebsites.forEach((site, i) => { %>
          <div class="border p-4 rounded-xl mb-3">
            <p class="font-bold">#<%= i+1 %> <%= site.domain %></p>
            <p>Time: <%= formatDuration(site.totalHours) %></p>
            <p>Visits: <%= site.visits %></p>
          </div>
        <% }) %>

      </div>
    </div>

    <!-- RECENT -->
    <div class="bg-white p-6 rounded-2xl shadow">
      <h2 class="text-xl font-bold mb-4">Recent Activity</h2>

      <table class="w-full">
        <thead>
          <tr class="bg-gray-100">
            <th>Domain</th>
            <th>Category</th>
            <th>Time</th>
          </tr>
        </thead>

        <tbody>
          <% recentExtensionActivity.forEach(item => { %>
            <tr>
              <td><%= item.domain %></td>
              <td><%= item.category %></td>
              <td><%= formatDuration(item.hours) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

    </div>

  </div>

  <%- include("../partials/footer") %>
</body>
</html>