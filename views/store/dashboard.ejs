<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard</title>
  <link rel="stylesheet" href="/Output.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="min-h-screen bg-slate-950 text-slate-100">
  <%- include("../partials/navbar") %>

  <%
    function formatDuration(hours) {
      const totalMinutes = Math.round((Number(hours) || 0) * 60);
      const hrs = Math.floor(totalMinutes / 60);
      const mins = totalMinutes % 60;

      if (hrs === 0) return `${mins} min`;
      if (mins === 0) return `${hrs} hr`;
      return `${hrs} hr ${mins} min`;
    }

    const statusStyles = {
      "Healthy": "bg-emerald-500/15 text-emerald-300 border border-emerald-400/20",
      "Approaching Limit": "bg-amber-500/15 text-amber-300 border border-amber-400/20",
      "Limit Reached": "bg-rose-500/15 text-rose-300 border border-rose-400/20"
    };
  %>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="relative overflow-hidden rounded-[28px] border border-white/10 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 shadow-2xl mb-8">
      <div class="absolute -top-16 -left-16 h-56 w-56 rounded-full bg-indigo-500/20 blur-3xl"></div>
      <div class="absolute -bottom-16 -right-16 h-56 w-56 rounded-full bg-cyan-500/20 blur-3xl"></div>

      <div class="relative p-6 md:p-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div>
          <p class="text-sm uppercase tracking-[0.25em] text-indigo-300/80 mb-2">Digital Addiction Awareness</p>
          <h1 class="text-3xl md:text-4xl font-extrabold text-white">Welcome back, <%= userName || "User" %></h1>
          <p class="text-slate-300 mt-3 max-w-2xl">
            Monitor your daily screen habits, track website activity, and stay within your healthy limit with real-time insights.
          </p>

          <div class="flex flex-wrap gap-3 mt-5">
            <span class="inline-flex items-center rounded-full px-4 py-2 text-sm font-semibold <%= statusStyles[usageStatus] || statusStyles["Healthy"] %>">
              Status: <%= usageStatus %>
            </span>
            <span class="inline-flex items-center rounded-full px-4 py-2 text-sm font-semibold bg-white/5 text-slate-200 border border-white/10">
              Sessions Today: <%= todaySessionCount %>
            </span>
            <span class="inline-flex items-center rounded-full px-4 py-2 text-sm font-semibold bg-white/5 text-slate-200 border border-white/10">
              Top Category: <%= mostUsedCategory %>
            </span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 min-w-[280px]">
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
            <p class="text-sm text-slate-400">Today</p>
            <p class="text-2xl font-bold text-white mt-1"><%= formatDuration(todayTotal) %></p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
            <p class="text-sm text-slate-400">Time Left</p>
            <p class="text-2xl font-bold text-emerald-300 mt-1"><%= formatDuration(timeLeft) %></p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
            <p class="text-sm text-slate-400">Weekly Total</p>
            <p class="text-2xl font-bold text-cyan-300 mt-1"><%= formatDuration(weeklyTotal) %></p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
            <p class="text-sm text-slate-400">Weekly Avg</p>
            <p class="text-2xl font-bold text-indigo-300 mt-1"><%= formatDuration(weeklyAverage) %></p>
          </div>
        </div>
      </div>
    </div>

    <% if (error) { %>
      <div class="mb-6 rounded-2xl border border-rose-400/20 bg-rose-500/10 p-4 text-rose-200">
        <%= error %>
      </div>
    <% } %>

    <div class="grid md:grid-cols-2 xl:grid-cols-5 gap-4 mb-8">
      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-xl backdrop-blur">
        <p class="text-sm text-slate-400">Today Usage</p>
        <p class="text-3xl font-bold text-white mt-2"><%= formatDuration(todayTotal) %></p>
        <p class="text-xs text-slate-500 mt-2">Your total tracked usage for today</p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-xl backdrop-blur">
        <p class="text-sm text-slate-400">Time Left</p>
        <p class="text-3xl font-bold text-emerald-300 mt-2"><%= formatDuration(timeLeft) %></p>
        <p class="text-xs text-slate-500 mt-2">Remaining before daily limit</p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-xl backdrop-blur">
        <p class="text-sm text-slate-400">Sessions</p>
        <p class="text-3xl font-bold text-cyan-300 mt-2"><%= todaySessionCount %></p>
        <p class="text-xs text-slate-500 mt-2">Tracked browsing sessions today</p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-xl backdrop-blur">
        <p class="text-sm text-slate-400">Top Category</p>
        <p class="text-2xl font-bold text-white mt-2"><%= mostUsedCategory %></p>
        <p class="text-xs text-slate-500 mt-2"><%= formatDuration(mostUsedCategoryHours) %></p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-5 shadow-xl backdrop-blur">
        <p class="text-sm text-slate-400">Usage Status</p>
        <p class="text-2xl font-bold mt-2 <%= usageStatus === 'Healthy' ? 'text-emerald-300' : usageStatus === 'Approaching Limit' ? 'text-amber-300' : 'text-rose-300' %>">
          <%= usageStatus %>
        </p>
        <p class="text-xs text-slate-500 mt-2">Live status based on limits</p>
      </div>
    </div>

    <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-6 shadow-xl backdrop-blur mb-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
        <div>
          <h2 class="text-2xl font-bold text-white">Daily Limit Overview</h2>
          <p class="text-slate-400">Track your warning, danger, and daily threshold in one place.</p>
        </div>
        <div class="text-sm text-slate-300 rounded-full border border-white/10 bg-white/5 px-4 py-2 inline-flex items-center">
          <%= progressPercent %>% used
        </div>
      </div>

      <div class="w-full h-4 bg-slate-800 rounded-full overflow-hidden">
        <div
          class="h-4 rounded-full bg-gradient-to-r from-cyan-400 via-indigo-500 to-fuchsia-500 transition-all duration-500"
          style="width: <%= progressPercent %>%"
        ></div>
      </div>

      <div class="grid md:grid-cols-3 gap-4 mt-6">
        <div class="rounded-2xl border border-amber-400/20 bg-amber-500/10 p-5">
          <p class="text-amber-300 font-semibold">Warning Limit</p>
          <p class="text-white text-xl font-bold mt-1"><%= formatDuration(warningLimit) %></p>
        </div>

        <div class="rounded-2xl border border-rose-400/20 bg-rose-500/10 p-5">
          <p class="text-rose-300 font-semibold">Danger Limit</p>
          <p class="text-white text-xl font-bold mt-1"><%= formatDuration(dangerLimit) %></p>
        </div>

        <div class="rounded-2xl border border-cyan-400/20 bg-cyan-500/10 p-5">
          <p class="text-cyan-300 font-semibold">Daily Limit</p>
          <p class="text-white text-xl font-bold mt-1"><%= formatDuration(dailyLimit) %></p>
        </div>
      </div>
    </div>

    <div class="grid xl:grid-cols-2 gap-8 mb-8">
      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-6 shadow-xl backdrop-blur">
        <div class="flex items-center justify-between mb-5">
          <div>
            <h2 class="text-2xl font-bold text-white">Weekly Graph</h2>
            <p class="text-slate-400">Your past 7 days of screen time</p>
          </div>
        </div>
        <div class="h-[320px]">
          <canvas id="weeklyBarChart"></canvas>
        </div>
      </div>

      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-6 shadow-xl backdrop-blur">
        <div class="flex items-center justify-between mb-5">
          <div>
            <h2 class="text-2xl font-bold text-white">Category Chart</h2>
            <p class="text-slate-400">Today's usage by category</p>
          </div>
        </div>
        <div class="h-[320px]">
          <canvas id="categoryPieChart"></canvas>
        </div>
      </div>
    </div>

    <div class="grid xl:grid-cols-2 gap-8 mb-8">
      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-6 shadow-xl backdrop-blur">
        <div class="flex items-center justify-between mb-5">
          <div>
            <h2 class="text-2xl font-bold text-white">Weekly Summary</h2>
            <p class="text-slate-400">Detailed usage for each day</p>
          </div>
        </div>

        <div class="space-y-3">
          <% weeklyBreakdown.forEach((day) => { 
               const dayPercent = weeklyTotal > 0 ? Math.min((day.total / weeklyTotal) * 100, 100) : 0;
          %>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="font-medium text-slate-200"><%= day.label %></span>
                <span class="font-semibold text-white"><%= formatDuration(day.total) %></span>
              </div>
              <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
                <div class="h-2 rounded-full bg-gradient-to-r from-cyan-400 to-indigo-500" style="width: <%= dayPercent %>%"></div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-6 shadow-xl backdrop-blur">
        <div class="flex items-center justify-between mb-5">
          <div>
            <h2 class="text-2xl font-bold text-white">Top Websites</h2>
            <p class="text-slate-400">Most visited sites from extension tracking</p>
          </div>
        </div>

        <div class="space-y-4">
          <% if (!topWebsites || topWebsites.length === 0) { %>
            <div class="rounded-2xl border border-dashed border-white/10 bg-white/5 p-6 text-center text-slate-400">
              No website tracking data available yet.
            </div>
          <% } %>

          <% (topWebsites || []).forEach((site, i) => { %>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-sm text-slate-400">#<%= i + 1 %></p>
                  <p class="text-lg font-bold text-white break-all"><%= site.domain %></p>
                  <p class="text-sm text-slate-400 mt-1"><%= site.category %></p>
                </div>
                <div class="text-right">
                  <p class="text-base font-semibold text-cyan-300"><%= formatDuration(site.totalHours) %></p>
                  <p class="text-sm text-slate-400"><%= site.visits %> visits</p>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-white/10 bg-slate-900/70 p-6 shadow-xl backdrop-blur">
      <div class="flex items-center justify-between mb-5">
        <div>
          <h2 class="text-2xl font-bold text-white">Recent Activity</h2>
          <p class="text-slate-400">Latest tracked browsing activity</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left overflow-hidden rounded-2xl">
          <thead>
            <tr class="border-b border-white/10 text-slate-300">
              <th class="py-4 px-4 font-semibold">Domain</th>
              <th class="py-4 px-4 font-semibold">Category</th>
              <th class="py-4 px-4 font-semibold">Time</th>
            </tr>
          </thead>
          <tbody>
            <% if (!recentExtensionActivity || recentExtensionActivity.length === 0) { %>
              <tr>
                <td colspan="3" class="py-8 px-4 text-center text-slate-400">No recent activity yet.</td>
              </tr>
            <% } %>

            <% (recentExtensionActivity || []).forEach(item => { %>
              <tr class="border-b border-white/5 hover:bg-white/5 transition">
                <td class="py-4 px-4 text-slate-100 break-all"><%= item.domain %></td>
                <td class="py-4 px-4">
                  <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold border border-white/10 bg-white/5 text-slate-200">
                    <%= item.category %>
                  </span>
                </td>
                <td class="py-4 px-4 text-cyan-300 font-medium"><%= formatDuration(item.hours) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include("../partials/footer") %>
  <%- include("../partials/toast") %>

  <script>
    const categoryLabels = <%- categoryChartLabels || "[]" %>;
    const categoryData = <%- categoryChartData || "[]" %>;
    const weeklyLabels = <%- weeklyChartLabels || "[]" %>;
    const weeklyData = <%- weeklyChartData || "[]" %>;

    Chart.defaults.color = "#cbd5e1";
    Chart.defaults.borderColor = "rgba(255,255,255,0.08)";
    Chart.defaults.font.family = "Inter, Segoe UI, Arial, sans-serif";

    const weeklyCtx = document.getElementById("weeklyBarChart");
    if (weeklyCtx) {
      new Chart(weeklyCtx, {
        type: "bar",
        data: {
          labels: weeklyLabels,
          datasets: [{
            label: "Hours Used",
            data: weeklyData,
            borderRadius: 12,
            backgroundColor: [
              "rgba(34, 211, 238, 0.85)",
              "rgba(59, 130, 246, 0.85)",
              "rgba(99, 102, 241, 0.85)",
              "rgba(139, 92, 246, 0.85)",
              "rgba(168, 85, 247, 0.85)",
              "rgba(236, 72, 153, 0.85)",
              "rgba(244, 63, 94, 0.85)"
            ]
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: "#cbd5e1" }
            },
            y: {
              beginAtZero: true,
              ticks: {
                color: "#cbd5e1",
                callback: (value) => value + "h"
              },
              grid: {
                color: "rgba(255,255,255,0.07)"
              }
            }
          }
        }
      });
    }

    const pieCtx = document.getElementById("categoryPieChart");
    if (pieCtx) {
      new Chart(pieCtx, {
        type: "pie",
        data: {
          labels: categoryLabels,
          datasets: [{
            data: categoryData,
            backgroundColor: [
              "rgba(34, 211, 238, 0.9)",
              "rgba(99, 102, 241, 0.9)",
              "rgba(16, 185, 129, 0.9)",
              "rgba(245, 158, 11, 0.9)",
              "rgba(244, 63, 94, 0.9)"
            ],
            borderColor: "rgba(15, 23, 42, 0.8)",
            borderWidth: 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: "bottom",
              labels: {
                color: "#e2e8f0",
                padding: 16,
                boxWidth: 14
              }
            }
          }
        }
      });
    }
  </script>
</body>
</html>