<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile Settings</title>
  <link rel="stylesheet" href="/Output.css">
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">
  <%- include("../partials/navbar") %>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold text-slate-900 mb-8">Profile Settings</h1>

    <% if (error) { %>
      <div class="mb-4 p-4 rounded-lg bg-red-100 text-red-700 border border-red-200">
        <%= error %>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="mb-4 p-4 rounded-lg bg-green-100 text-green-700 border border-green-200">
        <%= success %>
      </div>
    <% } %>

    <div class="grid lg:grid-cols-2 gap-8">
      <!-- Account & Limits -->
      <div class="bg-white rounded-3xl shadow border border-slate-200 p-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Account & Limits</h2>

        <form action="/profile-settings/update" method="POST" class="space-y-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              Full Name
            </label>
            <input
              type="text"
              name="name"
              value="<%= user.name %>"
              placeholder="Enter your full name"
              class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
              required
            >
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              Email Address
            </label>
            <input
              type="email"
              value="<%= user.email %>"
              class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg bg-slate-100 text-slate-600"
              disabled
            >
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              Daily Limit
            </label>
            <input
              type="number"
              step="1"
              min="1"
              max="24"
              name="dailyLimit"
              value="<%= user.dailyLimit %>"
              placeholder="e.g. 4"
              class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
              required
            >
            <p class="text-sm text-slate-500 mt-2">Enter total daily limit in hours. Example: 4</p>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              Warning Threshold
            </label>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-slate-500 mb-2">Hours</label>
                <input
                  type="number"
                  min="0"
                  max="24"
                  name="warningHours"
                  value="<%= Math.floor(user.warningLimit || 0) %>"
                  placeholder="1 hr"
                  class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg focus:outline-none focus:ring-2 focus:ring-yellow-500"
                  required
                >
              </div>

              <div>
                <label class="block text-xs text-slate-500 mb-2">Minutes</label>
                <input
                  type="number"
                  min="0"
                  max="59"
                  name="warningMinutes"
                  value="<%= Math.round(((user.warningLimit || 0) % 1) * 60) %>"
                  placeholder="60 min"
                  class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg focus:outline-none focus:ring-2 focus:ring-yellow-500"
                  required
                >
              </div>
            </div>
            <p class="text-sm text-slate-500 mt-2">
              Example: 1 hr 30 min
            </p>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              Danger Threshold
            </label>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-slate-500 mb-2">Hours</label>
                <input
                  type="number"
                  min="0"
                  max="24"
                  name="dangerHours"
                  value="<%= Math.floor(user.dangerLimit || 0) %>"
                  placeholder="2 hr"
                  class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg focus:outline-none focus:ring-2 focus:ring-red-500"
                  required
                >
              </div>

              <div>
                <label class="block text-xs text-slate-500 mb-2">Minutes</label>
                <input
                  type="number"
                  min="0"
                  max="59"
                  name="dangerMinutes"
                  value="<%= Math.round(((user.dangerLimit || 0) % 1) * 60) %>"
                  placeholder="60 min"
                  class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg focus:outline-none focus:ring-2 focus:ring-red-500"
                  required
                >
              </div>
            </div>
            <p class="text-sm text-slate-500 mt-2">
              Example: 2 hr 0 min
            </p>
          </div>

          <button
            type="submit"
            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-xl font-semibold py-4 rounded-2xl transition"
          >
            Save Preferences
          </button>
        </form>
      </div>

      <!-- Password -->
      <div class="bg-white rounded-3xl shadow border border-slate-200 p-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Change Password</h2>

        <form action="/profile-settings/password" method="POST" class="space-y-5">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              Current Password
            </label>
            <input
              type="password"
              name="currentPassword"
              placeholder="Enter current password"
              class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
              required
            >
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              New Password
            </label>
            <input
              type="password"
              name="newPassword"
              placeholder="Enter new password"
              class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
              required
            >
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">
              Confirm New Password
            </label>
            <input
              type="password"
              name="confirmNewPassword"
              placeholder="Confirm new password"
              class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
              required
            >
          </div>

          <button
            type="submit"
            class="w-full bg-slate-900 hover:bg-slate-800 text-white text-xl font-semibold py-4 rounded-2xl transition"
          >
            Update Password
          </button>
        </form>
      </div>
    </div>

    <!-- Extension Token -->
    <div class="mt-8 bg-white rounded-3xl shadow border border-slate-200 p-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Browser Extension Token</h2>
      <p class="text-slate-600 mb-4">
        This token connects your browser extension with your account.
      </p>

      <input
        id="extensionTokenInput"
        value="<%= user.extensionToken %>"
        readonly
        class="w-full border border-slate-300 rounded-2xl px-5 py-4 text-lg bg-slate-50 mb-4"
      >

      <div class="flex flex-wrap gap-3">
        <button
          type="button"
          onclick="copyToken()"
          class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-3 rounded-xl font-semibold"
        >
          Copy Token
        </button>

        <form action="/profile-settings/regenerate-extension-token" method="POST">
          <button
            type="submit"
            class="bg-red-600 hover:bg-red-700 text-white px-5 py-3 rounded-xl font-semibold"
          >
            Regenerate Token
          </button>
        </form>
      </div>
    </div>

    <!-- Custom Tracking Rules -->
    <div class="mt-8 bg-white rounded-3xl shadow border border-slate-200 p-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Custom Tracking Rules</h2>

      <form action="/tracking-rules/add" method="POST" class="grid md:grid-cols-3 gap-4 mb-6">
        <input
          type="text"
          name="pattern"
          placeholder="e.g. youtube.com"
          class="border border-slate-300 rounded-2xl px-5 py-4 text-lg"
          required
        >

        <select name="matchType" class="border border-slate-300 rounded-2xl px-5 py-4 text-lg">
          <option value="domain">Domain</option>
          <option value="url">Full URL</option>
          <option value="title">Page Title</option>
          <option value="contains">Contains</option>
        </select>

        <select name="category" class="border border-slate-300 rounded-2xl px-5 py-4 text-lg">
          <option value="Social Media">Social Media</option>
          <option value="Entertainment">Entertainment</option>
          <option value="Study">Study</option>
          <option value="Gaming">Gaming</option>
          <option value="Other">Other</option>
        </select>

        <div class="md:col-span-3">
          <button class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl font-semibold">
            Add Rule
          </button>
        </div>
      </form>

      <div class="space-y-4">
        <% if (trackingRules && trackingRules.length > 0) { %>
          <% trackingRules.forEach(rule => { %>
            <div class="border rounded-2xl p-4 flex items-center justify-between gap-4">
              <div>
                <p><strong>Pattern:</strong> <%= rule.pattern %></p>
                <p><strong>Match Type:</strong> <%= rule.matchType %></p>
                <p><strong>Category:</strong> <%= rule.category %></p>
              </div>

              <form action="/tracking-rules/delete/<%= rule._id %>" method="POST">
                <button class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-xl">
                  Delete
                </button>
              </form>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-slate-500">No custom tracking rules added yet.</p>
        <% } %>
      </div>
    </div>
  </div>

  <%- include("../partials/footer") %>

  <script>
    function copyToken() {
      const input = document.getElementById("extensionTokenInput");
      navigator.clipboard.writeText(input.value).then(() => {
        alert("Extension token copied");
      });
    }
  </script>
</body>
</html>