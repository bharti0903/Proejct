<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile Settings</title>
  <link rel="stylesheet" href="/Output.css">
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">
  <%- include("../partials/navbar") %>

  <div class="max-w-5xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Profile Settings</h1>

    <% if (error) { %><div class="mb-4 p-4 rounded-lg bg-red-100 text-red-700 border"><%= error %></div><% } %>
    <% if (success) { %><div class="mb-4 p-4 rounded-lg bg-green-100 text-green-700 border"><%= success %></div><% } %>

    <div class="grid lg:grid-cols-2 gap-8">
      <div class="bg-white rounded-2xl shadow border p-6">
        <h2 class="text-2xl font-bold mb-6">Account & Limits</h2>
        <form action="/profile-settings/update" method="POST" class="grid gap-4">
          <input name="name" value="<%= user.name %>" class="border rounded-lg px-4 py-3" required>
          <input value="<%= user.email %>" class="border rounded-lg px-4 py-3 bg-slate-100" disabled>
          <input type="number" step="0.1" min="1" max="24" name="dailyLimit" value="<%= user.dailyLimit %>" class="border rounded-lg px-4 py-3" required>

          <div class="grid grid-cols-2 gap-3">
            <input type="number" min="0" max="24" name="warningHours" value="<%= Math.floor(user.warningLimit || 0) %>" class="border rounded-lg px-4 py-3" required>
            <input type="number" min="0" max="59" name="warningMinutes" value="<%= Math.round(((user.warningLimit || 0) % 1) * 60) %>" class="border rounded-lg px-4 py-3" required>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <input type="number" min="0" max="24" name="dangerHours" value="<%= Math.floor(user.dangerLimit || 0) %>" class="border rounded-lg px-4 py-3" required>
            <input type="number" min="0" max="59" name="dangerMinutes" value="<%= Math.round(((user.dangerLimit || 0) % 1) * 60) %>" class="border rounded-lg px-4 py-3" required>
          </div>

          <button class="bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold">Save Preferences</button>
        </form>
      </div>

      <div class="bg-white rounded-2xl shadow border p-6">
        <h2 class="text-2xl font-bold mb-6">Change Password</h2>
        <form action="/profile-settings/password" method="POST" class="grid gap-4">
          <input type="password" name="currentPassword" placeholder="Current Password" class="border rounded-lg px-4 py-3" required>
          <input type="password" name="newPassword" placeholder="New Password" class="border rounded-lg px-4 py-3" required>
          <input type="password" name="confirmNewPassword" placeholder="Confirm New Password" class="border rounded-lg px-4 py-3" required>
          <button class="bg-slate-900 text-white px-6 py-3 rounded-lg font-semibold">Update Password</button>
        </form>
      </div>
    </div>

    <div class="mt-8 bg-white rounded-2xl shadow border p-6">
      <h2 class="text-2xl font-bold mb-4">Browser Extension Token</h2>
      <input id="extensionTokenInput" value="<%= user.extensionToken %>" readonly class="w-full border rounded-lg px-4 py-3 bg-slate-50 mb-4">

      <div class="flex gap-3">
        <button type="button" onclick="copyToken()" class="bg-indigo-600 text-white px-5 py-3 rounded-lg font-semibold">Copy</button>
        <form action="/profile-settings/regenerate-extension-token" method="POST">
          <button class="bg-red-600 text-white px-5 py-3 rounded-lg font-semibold">Regenerate Token</button>
        </form>
      </div>
    </div>
  </div>

  <%- include("../partials/footer") %>

  <script>
    function copyToken() {
      const input = document.getElementById("extensionTokenInput");
      navigator.clipboard.writeText(input.value).then(() => alert("Token copied"));
    }
  </script>
</body>
</html>