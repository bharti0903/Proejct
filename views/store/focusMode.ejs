<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Focus Mode</title>
  <link rel="stylesheet" href="/Output.css">
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">
  <%- include("../partials/navbar") %>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900">Focus Mode</h1>
      <p class="text-slate-600">Start a countdown session and block distracting websites.</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 mb-8">
      <div class="bg-white rounded-2xl shadow border p-6">
        <h2 class="text-2xl font-bold mb-6">Start Focus Session</h2>

        <div class="grid gap-4">
          <input id="durationMinutes" type="number" min="1" max="720" value="25" class="border rounded-lg px-4 py-3">
          <label class="flex items-center gap-3"><input id="blockDefaultSites" type="checkbox" checked> Block common distracting websites</label>
          <textarea id="customSites" rows="5" class="border rounded-lg px-4 py-3" placeholder="One site per line"></textarea>

          <div class="flex gap-3">
            <button id="startFocusBtn" class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold">Start Focus Mode</button>
            <button id="stopFocusBtn" class="bg-red-600 text-white px-6 py-3 rounded-lg font-semibold">Stop Focus Mode</button>
          </div>

          <div id="focusMessage" class="hidden p-4 rounded-lg border"></div>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow border p-6">
        <h2 class="text-2xl font-bold mb-6">Active Session</h2>
        <div class="grid gap-4">
          <div class="bg-slate-50 border rounded-xl p-5"><p class="text-sm text-slate-500">Status</p><p id="sessionStatus" class="text-2xl font-bold"><%= activeSession ? "Active" : "Inactive" %></p></div>
          <div class="bg-slate-50 border rounded-xl p-5"><p class="text-sm text-slate-500">Countdown</p><p id="countdownValue" class="text-4xl font-bold text-indigo-700">00:00:00</p></div>
          <div class="bg-slate-50 border rounded-xl p-5"><p class="text-sm text-slate-500">Blocked Sites</p><p id="blockedSitesCount" class="text-2xl font-bold"><%= activeSession && activeSession.blockedSites ? activeSession.blockedSites.length : 0 %></p></div>
        </div>
      </div>
    </div>
  </div>

  <%- include("../partials/footer") %>

  <script>
    const focusMessage = document.getElementById("focusMessage");
    const sessionStatus = document.getElementById("sessionStatus");
    const countdownValue = document.getElementById("countdownValue");
    const blockedSitesCount = document.getElementById("blockedSitesCount");
    let countdownInterval = null;

    function showMessage(text, isSuccess) {
      focusMessage.className = "p-4 rounded-lg border";
      focusMessage.classList.remove("hidden");
      focusMessage.classList.add(isSuccess ? "bg-green-100" : "bg-red-100");
      focusMessage.textContent = text;
    }

    function formatCountdown(ms) {
      if (!ms || ms <= 0) return "00:00:00";
      const totalSeconds = Math.floor(ms / 1000);
      const hrs = String(Math.floor(totalSeconds / 3600)).padStart(2, "0");
      const mins = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, "0");
      const secs = String(totalSeconds % 60).padStart(2, "0");
      return `${hrs}:${mins}:${secs}`;
    }

    function startCountdown(ms) {
      if (countdownInterval) clearInterval(countdownInterval);
      let remaining = ms;
      countdownValue.textContent = formatCountdown(remaining);

      countdownInterval = setInterval(() => {
        remaining -= 1000;
        if (remaining <= 0) {
          clearInterval(countdownInterval);
          countdownValue.textContent = "00:00:00";
          sessionStatus.textContent = "Inactive";
          blockedSitesCount.textContent = "0";
          return;
        }
        countdownValue.textContent = formatCountdown(remaining);
      }, 1000);
    }

    async function loadActiveSession() {
      const response = await fetch("/focus-mode/active");
      const data = await response.json();

      if (!data.success || !data.active) {
        sessionStatus.textContent = "Inactive";
        countdownValue.textContent = "00:00:00";
        blockedSitesCount.textContent = "0";
        return;
      }

      sessionStatus.textContent = "Active";
      blockedSitesCount.textContent = (data.session.blockedSites || []).length;
      startCountdown(data.session.remainingMs || 0);
    }

    document.getElementById("startFocusBtn").addEventListener("click", async () => {
      const customSites = document.getElementById("customSites").value.split("\n").map(v => v.trim()).filter(Boolean);

      const response = await fetch("/focus-mode/start", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          durationMinutes: Number(document.getElementById("durationMinutes").value),
          blockDistractingSites: document.getElementById("blockDefaultSites").checked,
          customSites
        })
      });

      const data = await response.json();
      showMessage(data.message || "Done", data.success);
      if (data.success) loadActiveSession();
    });

    document.getElementById("stopFocusBtn").addEventListener("click", async () => {
      const response = await fetch("/focus-mode/stop", { method: "POST" });
      const data = await response.json();
      showMessage(data.message || "Done", data.success);
      if (data.success) setTimeout(() => window.location.reload(), 500);
    });

    loadActiveSession();
  </script>
</body>
</html>