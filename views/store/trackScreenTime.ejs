<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Track Screen Time</title>
  <link rel="stylesheet" href="/Output.css">
</head>
<body class="bg-slate-50 min-h-screen text-slate-800">
  <%- include("../partials/navbar") %>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900">Activity Tracking</h1>
      <p class="text-slate-600">Track live sessions and manual entries.</p>
    </div>

    <div class="grid md:grid-cols-4 gap-4 mb-8">
      <div class="bg-white p-5 rounded-2xl shadow border"><p class="text-sm text-slate-500">Today</p><p class="text-2xl font-bold"><%= todayTotal %> hrs</p></div>
      <div class="bg-white p-5 rounded-2xl shadow border"><p class="text-sm text-slate-500">Time Left</p><p class="text-2xl font-bold"><%= timeLeft %> hrs</p></div>
      <div class="bg-white p-5 rounded-2xl shadow border"><p class="text-sm text-slate-500">Sessions</p><p class="text-2xl font-bold"><%= sessionCount %></p></div>
      <div class="bg-white p-5 rounded-2xl shadow border"><p class="text-sm text-slate-500">Status</p><p class="text-2xl font-bold"><%= usageStatus %></p></div>
    </div>

    <div class="bg-white rounded-2xl shadow border p-6 mb-8">
      <h2 class="text-2xl font-bold mb-4">Live Session Timer</h2>
      <p id="liveTimer" class="text-5xl font-bold mb-4">00:00:00</p>

      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <select id="sessionCategory" class="border rounded-lg px-4 py-3">
          <option value="Social Media">Social Media</option>
          <option value="Entertainment">Entertainment</option>
          <option value="Study">Study</option>
          <option value="Gaming">Gaming</option>
          <option value="Other">Other</option>
        </select>
        <input id="sessionNotes" class="border rounded-lg px-4 py-3" placeholder="Optional notes">
      </div>

      <div class="flex gap-3">
        <button id="startBtn" class="bg-green-600 text-white px-6 py-3 rounded-lg font-semibold">Start</button>
        <button id="stopBtn" class="bg-red-600 text-white px-6 py-3 rounded-lg font-semibold" disabled>Stop & Save</button>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow border p-6 mb-8">
      <h2 class="text-2xl font-bold mb-4"><%= editEntry ? "Edit Entry" : "Add Manual Entry" %></h2>

      <form action="<%= editEntry ? '/track-screen-time/update/' + editEntry._id : '/track-screen-time' %>" method="POST" class="grid md:grid-cols-2 gap-4">
        <select name="category" class="border rounded-lg px-4 py-3" required>
          <option value="Social Media" <%= editEntry && editEntry.category === 'Social Media' ? 'selected' : '' %>>Social Media</option>
          <option value="Entertainment" <%= editEntry && editEntry.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
          <option value="Study" <%= editEntry && editEntry.category === 'Study' ? 'selected' : '' %>>Study</option>
          <option value="Gaming" <%= editEntry && editEntry.category === 'Gaming' ? 'selected' : '' %>>Gaming</option>
          <option value="Other" <%= editEntry && editEntry.category === 'Other' ? 'selected' : '' %>>Other</option>
        </select>

        <input type="number" step="0.1" min="0" max="24" name="hours" value="<%= editEntry ? editEntry.hours : '' %>" class="border rounded-lg px-4 py-3" required>
        <input type="text" name="notes" value="<%= editEntry ? editEntry.notes : '' %>" class="md:col-span-2 border rounded-lg px-4 py-3" placeholder="Optional notes">

        <div class="md:col-span-2 flex gap-3">
          <button class="bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold">
            <%= editEntry ? "Update" : "Save" %>
          </button>
          <% if (editEntry) { %>
            <a href="/track-screen-time" class="px-6 py-3 rounded-lg border">Cancel</a>
          <% } %>
        </div>
      </form>
    </div>

    <div class="bg-white rounded-2xl shadow border p-6">
      <h2 class="text-2xl font-bold mb-4">Recent Entries</h2>
      <div class="space-y-4">
        <% entries.forEach(entry => { %>
          <div class="border rounded-xl p-4">
            <p><strong>Category:</strong> <%= entry.category %></p>
            <p><strong>Hours:</strong> <%= Number(entry.hours).toFixed(4) %></p>
            <p><strong>Source:</strong> <%= entry.source || "manual" %></p>
            <p><strong>Domain:</strong> <%= entry.domain || "N/A" %></p>
            <p><strong>Title:</strong> <%= entry.title || "N/A" %></p>
            <p><strong>Notes:</strong> <%= entry.notes || "No notes" %></p>
            <div class="mt-3 flex gap-3">
              <a href="/track-screen-time/edit/<%= entry._id %>" class="bg-yellow-500 text-white px-4 py-2 rounded-lg">Edit</a>
              <form action="/track-screen-time/delete/<%= entry._id %>" method="POST">
                <button class="bg-red-500 text-white px-4 py-2 rounded-lg">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <%- include("../partials/footer") %>
  <%- include("../partials/toast", { userId }) %>

  <script>
    let timerInterval = null;
    let elapsedSeconds = 0;
    const liveTimer = document.getElementById("liveTimer");
    const startBtn = document.getElementById("startBtn");
    const stopBtn = document.getElementById("stopBtn");

    function formatClock(totalSeconds) {
      const hrs = String(Math.floor(totalSeconds / 3600)).padStart(2, "0");
      const mins = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, "0");
      const secs = String(totalSeconds % 60).padStart(2, "0");
      return `${hrs}:${mins}:${secs}`;
    }

    startBtn.addEventListener("click", () => {
      if (timerInterval) return;
      elapsedSeconds = 0;
      liveTimer.textContent = "00:00:00";
      startBtn.disabled = true;
      stopBtn.disabled = false;

      timerInterval = setInterval(() => {
        elapsedSeconds += 1;
        liveTimer.textContent = formatClock(elapsedSeconds);
      }, 1000);
    });

    stopBtn.addEventListener("click", async () => {
      if (!timerInterval) return;
      clearInterval(timerInterval);
      timerInterval = null;
      startBtn.disabled = false;
      stopBtn.disabled = true;

      await fetch("/track-screen-time/session", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          category: document.getElementById("sessionCategory").value,
          minutes: elapsedSeconds / 60,
          notes: document.getElementById("sessionNotes").value
        })
      });

      window.location.reload();
    });
  </script>
</body>
</html>