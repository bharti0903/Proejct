<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Track Screen Time</title>
  <link rel="stylesheet" href="/Output.css">
</head>

<body class="bg-slate-950 min-h-screen text-slate-100">
  <%- include("../partials/navbar") %>

  <% 
    function formatDuration(hours) {
      const totalMinutes = Math.round((Number(hours) || 0) * 60);
      const hrs = Math.floor(totalMinutes / 60);
      const mins = totalMinutes % 60;
      if (hrs === 0) return `${mins} min`;
      if (mins === 0) return `${hrs} hr`;
      return `${hrs} hr ${mins} min`;
    }
  %>

  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-white">Activity Tracking</h1>
      <p class="text-slate-400">Track live sessions and manual entries</p>
    </div>

    <% if (error) { %>
      <div class="mb-4 rounded-2xl border border-rose-400/20 bg-rose-500/10 p-4 text-rose-200">
        <%= error %>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="mb-4 rounded-2xl border border-emerald-400/20 bg-emerald-500/10 p-4 text-emerald-200">
        <%= success %>
      </div>
    <% } %>

    <div id="thresholdPopup" class="hidden fixed top-6 right-6 z-[99999] w-[340px] rounded-2xl shadow-2xl p-5 text-white font-semibold backdrop-blur-xl border border-white/10"></div>

    <div class="grid md:grid-cols-4 gap-4 mb-8">
      <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-5 shadow-xl">
        <p class="text-sm text-slate-400">Today</p>
        <p id="todayTotalCard" class="text-2xl font-bold text-white mt-2"><%= formatDuration(todayTotal) %></p>
      </div>

      <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-5 shadow-xl">
        <p class="text-sm text-slate-400">Time Left</p>
        <p id="timeLeftCard" class="text-2xl font-bold text-white mt-2"><%= formatDuration(timeLeft) %></p>
      </div>

      <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-5 shadow-xl">
        <p class="text-sm text-slate-400">Sessions</p>
        <p id="sessionCountCard" class="text-2xl font-bold text-white mt-2"><%= sessionCount %></p>
      </div>

      <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-5 shadow-xl">
        <p class="text-sm text-slate-400">Status</p>
        <p id="usageStatusCard" class="text-2xl font-bold text-white mt-2"><%= usageStatus %></p>
      </div>
    </div>

    <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-6 shadow-xl mb-8 text-center">
      <h2 class="text-2xl font-bold mb-4">Live Session</h2>
      <p id="liveTimer" class="text-6xl font-black mb-3">00:00:00</p>
      <p id="liveSessionHint" class="text-slate-400 mb-6">Start session</p>

      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <select id="sessionCategory" class="bg-slate-950 border border-white/10 rounded-xl px-4 py-3">
          <option>Social Media</option>
          <option>Entertainment</option>
          <option>Study</option>
          <option>Gaming</option>
          <option>Other</option>
        </select>

        <input id="sessionNotes" placeholder="Notes" class="bg-slate-950 border border-white/10 rounded-xl px-4 py-3">
      </div>

      <div class="flex justify-center gap-4">
        <button id="startBtn" class="bg-green-500 px-6 py-3 rounded-xl font-semibold shadow-lg">
          Start
        </button>

        <button id="stopBtn" class="bg-red-500 px-6 py-3 rounded-xl font-semibold shadow-lg" disabled>
          Stop
        </button>
      </div>
    </div>

    <div class="bg-slate-900/70 border border-white/10 rounded-3xl p-6 shadow-xl">
      <h2 class="text-2xl font-bold mb-4">Recent Entries</h2>

      <div id="recentEntriesList" class="space-y-4">
        <% entries.forEach(entry => { %>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
            <p><strong><%= entry.category %></strong></p>
            <p><%= formatDuration(entry.hours) %></p>
            <p class="text-sm text-slate-400"><%= entry.notes || "No notes" %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <%- include("../partials/footer") %>
  <%- include("../partials/toast", { userId }) %>

  <script>
    let timerInterval = null;
    let elapsedSeconds = 0;

    const popup = document.getElementById("thresholdPopup");
    const liveTimer = document.getElementById("liveTimer");
    const startBtn = document.getElementById("startBtn");
    const stopBtn = document.getElementById("stopBtn");
    const liveSessionHint = document.getElementById("liveSessionHint");

    function showPopup(msg, type) {
      popup.classList.remove("hidden");
      popup.innerText = msg;

      if (type === "warning") {
        popup.style.background = "linear-gradient(to right,#f59e0b,#d97706)";
      } else if (type === "danger") {
        popup.style.background = "linear-gradient(to right,#ef4444,#b91c1c)";
      } else {
        popup.style.background = "linear-gradient(to right,#3b82f6,#1d4ed8)";
      }

      clearTimeout(window.__popupTimer);
      window.__popupTimer = setTimeout(() => popup.classList.add("hidden"), 4000);
    }

    function formatClock(s) {
      const h = String(Math.floor(s / 3600)).padStart(2, "0");
      const m = String(Math.floor((s % 3600) / 60)).padStart(2, "0");
      const sec = String(s % 60).padStart(2, "0");
      return `${h}:${m}:${sec}`;
    }

    function startLocalTimer(fromSeconds = 0) {
      if (timerInterval) clearInterval(timerInterval);

      elapsedSeconds = fromSeconds;
      liveTimer.innerText = formatClock(elapsedSeconds);

      timerInterval = setInterval(() => {
        elapsedSeconds++;
        liveTimer.innerText = formatClock(elapsedSeconds);
      }, 1000);
    }

    async function startBackendLiveSession() {
      const response = await fetch("/live-session/start", {
        method: "POST",
        headers: { "Content-Type": "application/json" }
      });

      return response.json();
    }

    async function stopBackendLiveSession() {
      const response = await fetch("/live-session/stop", {
        method: "POST",
        headers: { "Content-Type": "application/json" }
      });

      return response.json();
    }

    async function getBackendLiveSessionStatus() {
      const response = await fetch("/live-session/status", {
        method: "GET",
        headers: { "Content-Type": "application/json" }
      });

      return response.json();
    }

    async function restoreLiveSession() {
      try {
        const data = await getBackendLiveSessionStatus();

        if (!data.success || !data.active) {
          startBtn.disabled = false;
          stopBtn.disabled = true;
          liveSessionHint.innerText = "Start session";
          liveTimer.innerText = "00:00:00";
          return;
        }

        const elapsedSecondsFromBackend = Math.floor((data.elapsedMinutes || 0) * 60);

        // show restored session, but still allow user to start a fresh one
        startBtn.disabled = false;
        stopBtn.disabled = false;
        liveSessionHint.innerText = "Live session active. Click Start to begin a new session.";
        startLocalTimer(elapsedSecondsFromBackend);
      } catch (error) {
        console.error("restoreLiveSession error:", error);
      }
    }

    startBtn.onclick = async () => {
      try {
        const data = await startBackendLiveSession();

        if (!data.success) {
          showPopup(data.message || "Could not start live session", "danger");
          return;
        }

        startBtn.disabled = false;
        stopBtn.disabled = false;
        liveSessionHint.innerText = "New live session active. Alerts will trigger again.";
        startLocalTimer(0);

        showPopup("New live session started", "info");
      } catch (error) {
        console.error(error);
        showPopup("Failed to start live session", "danger");
      }
    };

    stopBtn.onclick = async () => {
      try {
        await stopBackendLiveSession();
      } catch (error) {
        console.error(error);
      }

      clearInterval(timerInterval);
      timerInterval = null;
      elapsedSeconds = 0;
      liveTimer.innerText = "00:00:00";
      startBtn.disabled = false;
      stopBtn.disabled = true;
      liveSessionHint.innerText = "Start session";

      showPopup("Live session stopped", "info");
    };

    document.addEventListener("DOMContentLoaded", restoreLiveSession);
  </script>
</body>
</html>