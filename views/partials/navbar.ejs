<nav class="bg-white border-b border-slate-200 shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-2">
        <span class="text-xl font-bold text-indigo-600">DAAT</span>
        <span class="hidden sm:block text-sm text-slate-500">
          Digital Addiction Awareness Tracker
        </span>
      </div>

      <div class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-700">
        <a href="/dashboard" class="hover:text-indigo-600 transition">Dashboard</a>
        <a href="/track-screen-time" class="hover:text-indigo-600 transition">Track</a>
        <a href="/weekly-report" class="hover:text-indigo-600 transition">Weekly Report</a>
        <a href="/focus-mode" class="hover:text-indigo-600 transition">Focus Mode</a>
        <a href="/profile-settings" class="hover:text-indigo-600 transition">Profile</a>
      </div>

      <div class="flex items-center gap-3">
        <% if (currentUser) { %>
          <span class="hidden sm:block text-sm text-slate-600">
            👋 <%= currentUser %>
          </span>

          <a
            href="/logout"
            class="bg-red-500 hover:bg-red-600 text-white text-sm px-4 py-2 rounded-lg transition"
          >
            Logout
          </a>
        <% } else { %>
          <a
            href="/login"
            class="text-sm px-4 py-2 rounded-lg border border-slate-300 hover:bg-slate-100"
          >
            Login
          </a>

          <a
            href="/signup"
            class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm px-4 py-2 rounded-lg transition"
          >
            Sign Up
          </a>
        <% } %>

        <button
          id="menuToggle"
          class="md:hidden text-xl text-slate-700 focus:outline-none"
          type="button"
        >
          ☰
        </button>
      </div>
    </div>

    <div id="mobileMenu" class="hidden md:hidden pb-4">
      <div class="flex flex-col gap-3 text-sm font-medium text-slate-700">
        <a href="/dashboard" class="hover:text-indigo-600">Dashboard</a>
        <a href="/track-screen-time" class="hover:text-indigo-600">Track</a>
        <a href="/weekly-report" class="hover:text-indigo-600">Weekly Report</a>
        <a href="/focus-mode" class="hover:text-indigo-600">Focus Mode</a>
        <a href="/profile-settings" class="hover:text-indigo-600">Profile</a>

        <% if (currentUser) { %>
          <a href="/logout" class="text-red-600">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
          <a href="/signup">Sign Up</a>
        <% } %>
      </div>
    </div>
