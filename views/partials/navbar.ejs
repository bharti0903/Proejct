<nav class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <div class="flex items-center gap-3">
        <div class="h-11 w-11 rounded-2xl bg-gradient-to-br from-cyan-400 via-indigo-500 to-fuchsia-500 shadow-lg shadow-indigo-900/30 flex items-center justify-center">
          <span class="text-white text-base font-black tracking-wide">DA</span>
        </div>

        <div>
          <div class="text-lg font-extrabold text-white leading-tight">DAAT</div>
          <div class="hidden sm:block text-xs text-slate-400 tracking-wide">
            Digital Addiction Awareness Tracker
          </div>
        </div>
      </div>

      <div class="hidden md:flex items-center gap-2 text-sm font-medium">
        <a href="/dashboard" class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition">Dashboard</a>
        <a href="/track-screen-time" class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition">Track</a>
        <a href="/weekly-report" class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition">Weekly Report</a>
        <a href="/focus-mode" class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition">Focus Mode</a>
        <a href="/profile-settings" class="px-4 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition">Profile</a>
      </div>

      <div class="flex items-center gap-3">
        <% if (currentUser) { %>
          <div class="relative">
            <button
              id="notificationBell"
              type="button"
              class="relative h-11 w-11 rounded-2xl border border-white/10 bg-white/5 text-slate-200 flex items-center justify-center hover:bg-white/10 transition"
              aria-label="Notifications"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 1 0-12 0v3.2a2 2 0 0 1-.6 1.4L4 17h5"/>
                <path d="M9 17a3 3 0 0 0 6 0"/>
              </svg>

              <span
                id="notificationCount"
                class="hidden absolute -top-1 -right-1 min-w-[20px] h-5 px-1 rounded-full bg-rose-500 text-white text-[11px] font-bold flex items-center justify-center"
              >
                0
              </span>
            </button>

            <div
              id="notificationDropdown"
              class="hidden absolute right-0 mt-3 w-[380px] rounded-3xl border border-white/10 bg-slate-900/95 backdrop-blur-xl shadow-2xl overflow-hidden"
            >
              <div class="flex items-center justify-between px-5 py-4 border-b border-white/10">
                <div>
                  <p class="text-white font-bold text-base">Notifications</p>
                  <p class="text-slate-400 text-xs">Real-time alert updates</p>
                </div>

                <div class="flex items-center gap-3">
                  <button
                    id="markAllReadBtn"
                    type="button"
                    class="text-cyan-300 text-sm font-semibold hover:underline"
                  >
                    Mark all read
                  </button>
                  <a href="/alerts" class="text-slate-300 text-sm font-semibold hover:underline">View all</a>
                </div>
              </div>

              <div id="notificationList" class="max-h-[360px] overflow-y-auto">
                <div class="px-5 py-6 text-slate-400 text-sm">Loading alerts...</div>
              </div>
            </div>
          </div>

          <div class="hidden sm:flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-2">
            <div class="h-9 w-9 rounded-full bg-gradient-to-br from-cyan-400 to-indigo-500 flex items-center justify-center text-white text-sm font-bold">
              <%= String(currentUser).charAt(0).toUpperCase() %>
            </div>
            <div class="text-sm text-slate-200 font-medium">
              <%= currentUser %>
            </div>
          </div>

          <a
            href="/logout"
            class="rounded-2xl bg-gradient-to-r from-rose-500 to-red-600 text-white text-sm font-semibold px-5 py-2.5 shadow-lg shadow-rose-900/30 hover:scale-[1.02] transition"
          >
            Logout
          </a>
        <% } else { %>
          <a
            href="/login"
            class="text-sm px-4 py-2.5 rounded-2xl border border-white/10 bg-white/5 text-slate-200 hover:bg-white/10 transition"
          >
            Login
          </a>

          <a
            href="/signup"
            class="bg-gradient-to-r from-cyan-500 to-indigo-600 text-white text-sm font-semibold px-5 py-2.5 rounded-2xl shadow-lg shadow-cyan-900/30 hover:scale-[1.02] transition"
          >
            Sign Up
          </a>
        <% } %>

        <button
          id="menuToggle"
          class="md:hidden h-11 w-11 rounded-2xl border border-white/10 bg-white/5 text-slate-200 text-xl flex items-center justify-center focus:outline-none"
          type="button"
        >
          ☰
        </button>
      </div>
    </div>

    <div id="mobileMenu" class="hidden md:hidden pb-5">
      <div class="rounded-3xl border border-white/10 bg-slate-900/90 backdrop-blur-xl p-4 shadow-2xl">
        <div class="flex flex-col gap-2 text-sm font-medium">
          <a href="/dashboard" class="rounded-xl px-4 py-3 text-slate-200 hover:bg-white/5 transition">Dashboard</a>
          <a href="/track-screen-time" class="rounded-xl px-4 py-3 text-slate-200 hover:bg-white/5 transition">Track</a>
          <a href="/weekly-report" class="rounded-xl px-4 py-3 text-slate-200 hover:bg-white/5 transition">Weekly Report</a>
          <a href="/focus-mode" class="rounded-xl px-4 py-3 text-slate-200 hover:bg-white/5 transition">Focus Mode</a>
          <a href="/profile-settings" class="rounded-xl px-4 py-3 text-slate-200 hover:bg-white/5 transition">Profile</a>
          <a href="/alerts" class="rounded-xl px-4 py-3 text-slate-200 hover:bg-white/5 transition">Alerts</a>

          <div class="h-px bg-white/10 my-2"></div>

          <% if (currentUser) { %>
            <div class="rounded-xl px-4 py-3 text-slate-300 bg-white/5">
              Signed in as <span class="text-white font-semibold"><%= currentUser %></span>
            </div>
            <a href="/logout" class="rounded-xl px-4 py-3 text-rose-300 hover:bg-rose-500/10 transition">Logout</a>
          <% } else { %>
            <a href="/login" class="rounded-xl px-4 py-3 text-slate-200 hover:bg-white/5 transition">Login</a>
            <a href="/signup" class="rounded-xl px-4 py-3 text-cyan-300 hover:bg-cyan-500/10 transition">Sign Up</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</nav>

<script src="/socket.io/socket.io.js"></script>
<script>
  const toggleBtn = document.getElementById("menuToggle");
  const mobileMenu = document.getElementById("mobileMenu");

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
  }

  const notificationBell = document.getElementById("notificationBell");
  const notificationDropdown = document.getElementById("notificationDropdown");
  const notificationList = document.getElementById("notificationList");
  const notificationCount = document.getElementById("notificationCount");
  const markAllReadBtn = document.getElementById("markAllReadBtn");

  let currentAlerts = [];
  let lastAlertIds = new Set();

  function formatNotificationTime(dateStr) {
    return new Date(dateStr).toLocaleString();
  }

  function setUnreadCount(count) {
    if (!notificationCount) return;

    if (count > 0) {
      notificationCount.textContent = count > 9 ? "9+" : String(count);
      notificationCount.classList.remove("hidden");
    } else {
      notificationCount.classList.add("hidden");
    }
  }

  function playBellSound() {
    try {
      const audio = new Audio("https://www.soundjay.com/buttons/beep-07.wav");
      audio.volume = 0.3;
      audio.play().catch(() => {});
    } catch (error) {}
  }

  function getAlertClasses(type, isRead) {
    const t = String(type || "").toLowerCase();

    if (t === "danger") {
      return {
        badge: "bg-rose-500/15 text-rose-300 border border-rose-400/20",
        dot: "bg-rose-400",
        opacity: isRead ? "opacity-60" : "",
      };
    }

    if (t === "warning") {
      return {
        badge: "bg-amber-500/15 text-amber-300 border border-amber-400/20",
        dot: "bg-amber-400",
        opacity: isRead ? "opacity-60" : "",
      };
    }

    return {
      badge: "bg-cyan-500/15 text-cyan-300 border border-cyan-400/20",
      dot: "bg-cyan-400",
      opacity: isRead ? "opacity-60" : "",
    };
  }

  async function markAlertRead(id) {
    try {
      const response = await fetch(`/alerts/api/${id}/read`, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
      });

      const data = await response.json();
      if (!data.success) return;

      currentAlerts = currentAlerts.map((item) =>
        item._id === id ? { ...item, isRead: true } : item
      );

      setUnreadCount(data.unreadCount || 0);
      renderNotifications();
    } catch (error) {
      console.error("markAlertRead error:", error);
    }
  }

  async function markAllRead() {
    try {
      const response = await fetch("/alerts/api/read-all", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
      });

      const data = await response.json();
      if (!data.success) return;

      currentAlerts = currentAlerts.map((item) => ({
        ...item,
        isRead: true,
      }));

      setUnreadCount(data.unreadCount || 0);
      renderNotifications();
    } catch (error) {
      console.error("markAllRead error:", error);
    }
  }

  function renderNotifications() {
    if (!notificationList) return;

    if (!currentAlerts.length) {
      notificationList.innerHTML = '<div class="px-5 py-6 text-slate-400 text-sm">No notifications yet.</div>';
      return;
    }

    notificationList.innerHTML = currentAlerts.map((alert) => {
      const classes = getAlertClasses(alert.type, alert.isRead);

      return `
        <div class="px-5 py-4 border-b border-white/5 hover:bg-white/5 transition ${classes.opacity}">
          <div class="flex items-start gap-3">
            <span class="mt-1 h-2.5 w-2.5 rounded-full ${classes.dot}"></span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-3 mb-1">
                <span class="inline-flex rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide ${classes.badge}">
                  ${alert.type}
                </span>
                ${alert.isRead ? '' : `<button class="text-xs text-cyan-300 font-semibold hover:underline mark-read-btn" data-id="${alert._id}">Mark read</button>`}
              </div>
              <p class="text-sm text-slate-100 leading-6">${alert.message}</p>
              <p class="text-xs text-slate-500 mt-2">${formatNotificationTime(alert.createdAt)}</p>
            </div>
          </div>
        </div>
      `;
    }).join("");

    document.querySelectorAll(".mark-read-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        markAlertRead(btn.dataset.id);
      });
    });
  }

  async function loadNotifications() {
    if (!notificationList) return;

    try {
      const response = await fetch("/alerts/api/recent");
      const data = await response.json();

      if (!data.success) {
        notificationList.innerHTML = '<div class="px-5 py-6 text-rose-300 text-sm">Failed to load notifications.</div>';
        return;
      }

      currentAlerts = data.alerts || [];
      setUnreadCount(data.unreadCount || 0);
      renderNotifications();
    } catch (error) {
      notificationList.innerHTML = '<div class="px-5 py-6 text-rose-300 text-sm">Error loading notifications.</div>';
    }
  }

  if (markAllReadBtn) {
    markAllReadBtn.addEventListener("click", markAllRead);
  }

  if (notificationBell && notificationDropdown) {
    notificationBell.addEventListener("click", async (e) => {
      e.stopPropagation();
      notificationDropdown.classList.toggle("hidden");

      if (!notificationDropdown.classList.contains("hidden")) {
        await loadNotifications();
      }
    });

    document.addEventListener("click", (e) => {
      if (!notificationDropdown.contains(e.target) && !notificationBell.contains(e.target)) {
        notificationDropdown.classList.add("hidden");
      }
    });

    loadNotifications();
    setInterval(loadNotifications, 10000);
  }

  <% if (userId) { %>
    const socket = io();
    socket.emit("joinUserRoom", "<%= userId %>");

    socket.on("newAlert", (alertData) => {
      if (lastAlertIds.has(alertData.id)) return;

      lastAlertIds.add(alertData.id);

      currentAlerts.unshift({
        _id: alertData.id,
        type: alertData.type,
        message: alertData.message,
        createdAt: alertData.createdAt,
        isRead: false,
      });

      currentAlerts = currentAlerts.slice(0, 10);
      setUnreadCount(alertData.unreadCount || 0);
      renderNotifications();
      playBellSound();
    });
  <% } %>
</script>