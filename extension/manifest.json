{
  "manifest_version": 3,
  "name": "Digital Addiction Awareness Tracker",
  "version": "3.2.4",
  "description": "Tracks browser usage and shows real-time alerts on websites like YouTube",

  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "idle",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost:5002/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "DAAT Tracker"
  },

  "options_page": "options.html",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
