{
  "name": "digital-addiction-awareness",
  "version": "1.0.0",
  "description": "Digital Addiction Awareness Tracker with browser extension, analytics, focus mode, alerts, and reports",
  "main": "app.js",
  "scripts": {
    "tailwind": "npx @tailwindcss/cli -i ./views/input.css -o ./public/Output.css",
    "tailwind:watch": "npx @tailwindcss/cli -i ./views/input.css -o ./public/Output.css --watch",
    "start": "nodemon app.js",
    "dev": "concurrently \"nodemon app.js\" \"npm run tailwind:watch\""
  },
